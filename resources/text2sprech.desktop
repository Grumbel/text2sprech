[Desktop Entry]
Type=Application
Version=1.0
Name=text2sprech
GenericName=Text-to-Speech Reader
Comment=Local text-to-speech reader with live sentence highlighting
Exec=text2sprech %f
TryExec=text2sprech
Icon=text2sprech
Terminal=false
StartupNotify=true
StartupWMClass=text2sprech
Categories=Utility;Accessibility;AudioVideo;
MimeType=text/plain;text/html;
Keywords=tts;speech;accessibility;audiobook;piper;
# Right-click on the launcher / menu entry (Desktop Entry Spec “Actions”).
Actions=speak-clipboard;
X-License=GPL-3.0-or-later

[Desktop Action speak-clipboard]
Name=Speak Clipboard
Exec=text2sprech --paste-clipboard --autoplay
